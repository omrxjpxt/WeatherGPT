# WeatherGPT Backend Configuration Template
# Copy this file to .env and configure for your environment.

# ── General Server Settings ──
PROJECT_NAME="WeatherGPT Backend"
VERSION="0.1.0"
# Set to "production" in live environments (enforces no-mock safeguards, strict CORS, and Firestore requirements)
ENVIRONMENT="development"
PORT=8000
LOG_LEVEL="INFO"

# ── External API Credentials ──
# Google Maps API Key (Used by Google Routes API and Google Geocoding)
# Required for live vehicle and walking routing alternatives in production.
GOOGLE_MAPS_API_KEY=""

# Secondary Weather Provider (Optional corroboration feed)
WEATHERAPI_API_KEY=""

# LLM Provider Key (Optional Gemini API key for natural language explanations)
LLM_API_KEY=""
# GEMINI_API_KEY=""

# ── Provider Selections ──
WEATHER_PROVIDER="open-meteo"        # "open-meteo" or "mock"
ROUTING_PROVIDER="google"            # "google" or "mock"
GEOCODING_PROVIDER="auto"            # "auto", "google", "nominatim", "open-meteo", "gazetteer", "mock"
AIR_QUALITY_PROVIDER="open-meteo"    # "open-meteo", "mock", "disabled"
AIR_QUALITY_ENABLED=true
GOOGLE_TRAFFIC_AWARE=true
ALERT_PROVIDER="sachet"              # "sachet", "weatherapi", "mock"
TRANSIT_PROVIDER="dmrc"              # "dmrc", "mock"
HAZARD_PROVIDER="delhi_pwd"          # "delhi_pwd", "mock"
PINCODE_GEOCODING_ENABLED=true

# ── NDMA SACHET Disaster Alerts Feed ──
SACHET_FEED_URL="https://sachet.ndma.gov.in/cap_public_website/rss/rss_delhi.xml"
SACHET_TIMEOUT_SECONDS=3.0
SACHET_CACHE_TTL_SECONDS=300

# ── Firebase Persistence ──
# In production, set FIRESTORE_PROJECT_ID and point GOOGLE_APPLICATION_CREDENTIALS to service account key file.
# In development, leaving this empty activates non-blocking MEMORY_MODE.
FIRESTORE_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ── Security & Rate Limiting ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE_ANONYMOUS=30
RATE_LIMIT_PER_MINUTE_AUTHENTICATED=120
RATE_LIMIT_MAX_KEYS=10000
# Comma-separated list of trusted reverse proxy IPs (X-Forwarded-For is only trusted from these IPs)
# TRUSTED_PROXIES=["127.0.0.1", "::1"]

# ── CORS Origins ──
# In production, define explicit domain origins; wildcards ("*") are automatically stripped in production mode.
# CORS_ORIGINS=["https://weathergpt.com", "https://app.weathergpt.com"]
